{
  "name": "mintiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "test:contract": "bash -lc 'source /home/box/.cargo/env; cargo test --workspace --lib'",
    "demo": "node scripts/demo.mjs",
